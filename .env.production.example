COMPOSE_FILE=docker-compose.prod.yml

# ===== Aplicação =====
APP_NAME="Clínica Unicesumar"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clinica.example.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Domínio público roteado pelo Traefik (só o host, sem https://)
APP_HOST=clinica.example.com

# Embutido no bundle do front em tempo de build (rebuild para mudar)
VITE_APP_NAME="${APP_NAME}"

# ===== Banco de dados =====
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=clinica
DB_USERNAME=clinica
DB_PASSWORD=troque-esta-senha

# ===== Sessão =====
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=clinica.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ===== Cache / Fila / Arquivos =====
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=330

# ===== Mail =====
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Log =====
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ===== IA (campanhas de saúde) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
